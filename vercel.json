{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ph/lib.js",
      "destination": "https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js"
    },
    {
      "source": "/ph/t",
      "destination": "https://api-js.mixpanel.com/track/"
    },
    {
      "source": "/ph/e",
      "destination": "https://api-js.mixpanel.com/engage/"
    },
    {
      "source": "/ph/g",
      "destination": "https://api-js.mixpanel.com/groups/"
    },
    {
      "source": "/ph/r",
      "destination": "https://api-js.mixpanel.com/record/"
    },
    {
      "source": "/ph/f",
      "destination": "https://api-js.mixpanel.com/flags/"
    },
    {
      "source": "/ph/s",
      "destination": "https://api-js.mixpanel.com/settings/"
    }
  ]
}
